# ==============================================================================
# SupplyPrescript - Environment Variables Configuration
# Copy this file to '.env' and populate your sensitive credentials.
# Do NOT commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID (Web Application).
#
# Authorized redirect URIs in Google Cloud Console must match EXACTLY:
#   http://localhost:8000/auth/google/callback
#   http://127.0.0.1:8000/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ------------------------------------------------------------------------------
# 2. Facebook OAuth 2.0 Credentials
# Obtain these from Meta for Developers (developers.facebook.com) -> App Dashboard -> Settings -> Basic
# Configure Facebook Login for Web.
#
# Authorized redirect URIs in Facebook Login settings must match EXACTLY:
#   http://localhost:8000/auth/facebook/callback
#   http://127.0.0.1:8000/auth/facebook/callback
# ------------------------------------------------------------------------------
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback

# ------------------------------------------------------------------------------
# 3. Authentication & Security Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to strictly enforce authentication on all protected endpoints.
SUPPLYPRESCRIPT_ENFORCE_AUTH=true

# Custom SQLite database location (optional; defaults to database/supplyprescript.db)
# SUPPLYPRESCRIPT_DB_PATH=database/supplyprescript.db

# Initial seed passwords for default corporate accounts (optional)
# SUPPLYPRESCRIPT_ADMIN_PASSWORD=Admin@123
# SUPPLYPRESCRIPT_MANAGER_PASSWORD=Manager@123
# SUPPLYPRESCRIPT_ANALYST_PASSWORD=Analyst@123
